{
  "expo": {
    "name": "POCKETLY",
    "slug": "pocketly-daily-expenses",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoreal.png",
    "scheme": "mydailyexpensenew",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logoreal.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pocketly.dailyexpenses",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoreal.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#F5F7FA"
      },
      "navigationBar": {
        "visible": "sticky",
        "backgroundColor": "#4CAF50"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logoreal.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dac90a06-4356-46ba-83e0-fe41a99f3a1c"
      }
    }
  }
}